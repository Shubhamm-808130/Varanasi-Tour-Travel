<%- include('partials/header', { title: 'Varanasi Tour Packages | Kashi Darshan & Ayodhya Tours', activePage: 'packages' }) %>

<div class="text-white py-5" style="background: linear-gradient(rgba(15, 23, 42, 0.32), rgba(15, 23, 42, 0.45)), url('https://images.unsplash.com/photo-1561361513-2d000a50f0dc?auto=format&fit=crop&w=1600&q=80') center/cover; text-shadow: 0 2px 12px rgba(0,0,0,0.85);">
  <div class="container text-center py-3">
    <span class="badge bg-warning text-dark fw-bold px-3 py-2 mb-2">Spiritual Pilgrimage & Sightseeing</span>
    <h1 class="fw-bold mb-2">Varanasi Tour Packages</h1>
    <p class="lead text-light-50 max-w-600 mx-auto">
      Carefully planned day tours and multi-day spiritual circuit packages with dedicated AC cab, boat rides, and local guides.
    </p>
  </div>
</div>

<div class="container py-5">
  <div class="row g-4">
    <% packages.forEach(pkg => { %>
      <div class="col-lg-6">
        <div class="custom-card">
          <div class="row g-0 flex-md-row">
            <div class="col-md-5 custom-card-img-wrapper" style="min-height: 240px;">
              <img src="<%= pkg.image_url %>" alt="<%= pkg.title %>" class="custom-card-img">
              <span class="card-top-tag badge bg-warning text-dark fw-bold"><%= pkg.badge %></span>
            </div>
            <div class="col-md-7 custom-card-body">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-light text-dark border"><i class="fa-solid fa-clock me-1 text-warning"></i> <%= pkg.duration %></span>
                <div>
                  <span class="text-decoration-line-through text-muted small me-1">₹<%= pkg.original_price %></span>
                  <span class="text-success fw-bold fs-5">₹<%= pkg.price.toLocaleString('en-IN') %></span>
                </div>
              </div>

              <h4 class="custom-card-title mb-2"><%= pkg.title %></h4>
              <p class="text-muted small mb-3"><%= pkg.subtitle %></p>

              <div class="small text-secondary mb-3">
                <strong><i class="fa-solid fa-check-double text-success me-1"></i> Highlights:</strong> <%= pkg.highlights %>
              </div>

              <div class="mt-auto d-flex gap-2 pt-2 border-top">
                <a href="/packages/<%= pkg.id %>" class="btn btn-outline-dark btn-sm flex-grow-1">
                  Full Itinerary
                </a>
                <a href="/booking/car?package_id=<%= pkg.id %>" class="btn btn-saffron btn-sm">
                  Book Package
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Custom Tour Inquiry Card -->
  <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mt-5 bg-white text-center">
    <h3 class="fw-bold text-primary mb-2">Need a Customized Varanasi & Uttar Pradesh Tour Package?</h3>
    <p class="text-muted max-w-600 mx-auto mb-4">
      Whether you want to combine Varanasi with Ayodhya, Prayagraj Sangam, Bodhgaya, Chitrakoot, or Naimisharanya, we can craft a tailored schedule for your family.
    </p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
      <a href="/contact" class="btn btn-primary-kashi">
        <i class="fa-solid fa-envelope me-2"></i> Send Custom Inquiry
      </a>
      <a href="https://wa.me/919876543210?text=Hello,%20I%20want%20a%20custom%20tour%20package" target="_blank" class="btn btn-whatsapp">
        <i class="fa-brands fa-whatsapp me-2"></i> WhatsApp Instant Quote
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
