<%- include('partials/header', { title: 'Visiting Places in Varanasi | Distance, Cost & Timings', activePage: 'attractions' }) %>

<div class="text-white py-5" style="background: linear-gradient(rgba(15, 23, 42, 0.32), rgba(15, 23, 42, 0.45)), url('https://images.unsplash.com/photo-1571536802807-30451e3955d8?auto=format&fit=crop&w=1600&q=80') center/cover; text-shadow: 0 2px 12px rgba(0,0,0,0.85);">
  <div class="container text-center py-4">
    <span class="badge bg-warning text-dark fw-bold px-3 py-2 mb-2">Complete Kashi Tourism Guide</span>
    <h1 class="fw-bold mb-3">Famous Visiting Places in Varanasi</h1>
    <p class="lead text-light-50 max-w-600 mx-auto">
      Check accurate distance from Varanasi Cantt Station, entry fees, aarti timings, and travel times for temples, ghats, and monuments.
    </p>
  </div>
</div>

<div class="container py-5">
  <!-- Search & Filter Controls -->
  <div class="card p-3 mb-5 border-0 shadow-sm bg-white rounded-3">
    <div class="row g-3 align-items-center">
      <div class="col-md-5">
        <div class="input-group">
          <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
          <input type="text" id="attractionSearch" class="form-control border-start-0" placeholder="Search place (e.g. Vishwanath, Aarti, Sarnath)...">
        </div>
      </div>
      <div class="col-md-7">
        <div class="d-flex flex-wrap gap-2 justify-content-md-end">
          <button class="btn btn-sm btn-primary-kashi filter-btn active" data-category="all">All Places</button>
          <button class="btn btn-sm btn-outline-secondary filter-btn" data-category="Temple">Temples</button>
          <button class="btn btn-sm btn-outline-secondary filter-btn" data-category="Ghat">Ghats</button>
          <button class="btn btn-sm btn-outline-secondary filter-btn" data-category="Excursion">Sarnath & Excursions</button>
          <button class="btn btn-sm btn-outline-secondary filter-btn" data-category="Heritage">Heritage & Forts</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Places Grid -->
  <div class="row g-4" id="attractionsGrid">
    <% attractions.forEach(place => { %>
      <div class="col-lg-4 col-md-6 attraction-item-card" 
           data-category="<%= place.category %>" 
           data-name="<%= place.name %> <%= place.hindi_name %>" 
           data-description="<%= place.description %>">
        <div class="custom-card">
          <div class="custom-card-img-wrapper">
            <img src="<%= place.image_url %>" alt="<%= place.name %>" class="custom-card-img" loading="lazy">
            <span class="card-top-tag badge-category"><%= place.category %></span>
            <span class="card-top-rate badge-cost">
              <%= place.entry_fee === 0 ? 'Free Entry' : '₹' + place.entry_fee + ' Entry' %>
            </span>
          </div>

          <div class="custom-card-body p-3 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-light text-primary border px-2 py-1" style="font-size: 11px;">
                  <i class="fa-solid fa-location-dot me-1"></i> <%= place.distance_km %> km from Cantt
                </span>
                <span class="text-muted" style="font-size: 11px;">
                  <i class="fa-regular fa-clock me-1"></i> <%= place.travel_time %>
                </span>
              </div>

              <h5 class="custom-card-title mb-1" style="font-size: 1.1rem;"><%= place.name %></h5>
              <div class="text-secondary small fw-medium mb-3"><%= place.hindi_name || '' %></div>
            </div>

            <!-- Clean Action Button -->
            <button type="button" class="btn btn-outline-dark btn-sm w-100 fw-semibold py-2" data-bs-toggle="modal" data-bs-target="#attractionModal<%= place.id %>">
              <i class="fa-solid fa-circle-info me-1 text-warning"></i> View Details & Timings
            </button>
          </div>
        </div>

        <!-- Attraction Modal (Details Visible Upon Click) -->
        <div class="modal fade" id="attractionModal<%= place.id %>" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
              <div class="position-relative">
                <img src="<%= place.image_url %>" alt="<%= place.name %>" style="width: 100%; height: 260px; object-fit: cover;">
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 p-2 bg-dark rounded-circle" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background: linear-gradient(to top, rgba(0,0,0,0.85), transparent);">
                  <span class="badge bg-warning text-dark fw-bold mb-1"><%= place.category %></span>
                  <h4 class="text-white fw-bold mb-0"><%= place.name %></h4>
                  <div class="text-warning small"><%= place.hindi_name %></div>
                </div>
              </div>

              <div class="modal-body p-4">
                <div class="row g-3 mb-3">
                  <div class="col-sm-4">
                    <div class="bg-light p-2 rounded border text-center">
                      <small class="text-muted d-block">Distance from Cantt</small>
                      <strong class="text-primary"><i class="fa-solid fa-route me-1"></i> <%= place.distance_km %> KM</strong>
                    </div>
                  </div>
                  <div class="col-sm-4">
                    <div class="bg-light p-2 rounded border text-center">
                      <small class="text-muted d-block">Travel Duration</small>
                      <strong class="text-dark"><i class="fa-regular fa-clock me-1"></i> <%= place.travel_time %></strong>
                    </div>
                  </div>
                  <div class="col-sm-4">
                    <div class="bg-light p-2 rounded border text-center">
                      <small class="text-muted d-block">Entry Ticket</small>
                      <strong class="text-success"><%= place.entry_fee === 0 ? 'Free Entry' : '₹' + place.entry_fee %></strong>
                    </div>
                  </div>
                </div>

                <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-om text-warning me-1"></i> Overview & Spiritual Significance</h6>
                <p class="text-muted small mb-3" style="line-height: 1.6;"><%= place.description %></p>

                <% if (place.timings) { %>
                  <div class="alert alert-light border small py-2 px-3 mb-3">
                    <div><strong><i class="fa-regular fa-clock text-warning me-1"></i> Darshan / Visiting Timings:</strong> <%= place.timings %></div>
                    <% if (place.best_time) { %>
                      <div class="mt-1"><strong><i class="fa-solid fa-sun text-warning me-1"></i> Recommended Time:</strong> <%= place.best_time %></div>
                    <% } %>
                  </div>
                <% } %>

                <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                  <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                  <a href="https://wa.me/<%= settings.whatsapp %>?text=Hello%20Varanasi%20Travels,%20I%20want%20to%20visit%20<%= encodeURIComponent(place.name) %>" target="_blank" class="btn btn-success btn-sm">
                    <i class="fa-brands fa-whatsapp me-1"></i> WhatsApp Inquiry
                  </a>
                  <a href="/booking/car?destination=<%= encodeURIComponent(place.name) %>" class="btn btn-warning btn-sm fw-bold text-dark">
                    <i class="fa-solid fa-taxi me-1"></i> Book Sightseeing Cab
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Booking CTA Box -->
  <div class="bg-primary text-white rounded-4 p-4 p-md-5 mt-5 text-center" style="background: linear-gradient(135deg, #0c2340 0%, #1e3a8a 100%) !important;">
    <h3 class="fw-bold mb-3">Want to Cover All Major Varanasi Places in One Day?</h3>
    <p class="lead text-light-50 mb-4 mx-auto max-w-600">
      Book our 8-Hour / 80-KM dedicated AC cab with a courteous local driver for a comfortable family sightseeing tour.
    </p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
      <a href="/booking/car" class="btn btn-saffron btn-lg">
        <i class="fa-solid fa-car-side me-2"></i> Book 8Hr Sightseeing Cab
      </a>
      <a href="tel:+919876543210" class="btn btn-outline-light btn-lg">
        <i class="fa-solid fa-phone me-2"></i> Call Us: +91-9876543210
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
