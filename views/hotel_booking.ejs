<%- include('partials/header', { title: 'Varanasi Hotels Booking | Ghat-side & Temple Proximity Stays', activePage: 'hotel' }) %>

<div class="text-white py-5" style="background: linear-gradient(rgba(15, 23, 42, 0.32), rgba(15, 23, 42, 0.45)), url('https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1600&q=80') center/cover; text-shadow: 0 2px 12px rgba(0,0,0,0.85);">
  <div class="container text-center py-3">
    <span class="badge bg-warning text-dark fw-bold px-3 py-2 mb-2">Verified Partner Accommodations</span>
    <h1 class="fw-bold mb-2">Varanasi Hotel Booking</h1>
    <p class="lead text-light-50 max-w-600 mx-auto">
      Handpicked Ghat-side Havelis, Luxury Palaces, and Budget Pilgrim Inns located within minutes of Kashi Vishwanath Corridor and Ganga Aarti.
    </p>
  </div>
</div>

<div class="container py-5">
  <div class="row g-5">
    <!-- Hotel Listings -->
    <div class="col-lg-8">
      <h3 class="fw-bold text-primary mb-4">Recommended Stays in Kashi</h3>
      <div class="row g-4">
        <% hotels.forEach(hotel => { %>
          <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
              <div class="row g-0">
                <div class="col-md-5">
                  <img src="<%= hotel.image_url %>" alt="<%= hotel.name %>" class="w-100 h-100" style="min-height: 220px; object-fit: cover;">
                </div>
                <div class="col-md-7 p-4 d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="badge bg-secondary-subtle text-dark"><%= hotel.category %></span>
                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-star me-1"></i> <%= hotel.rating %> (<%= hotel.reviews_count %> reviews)</span>
                  </div>

                  <h5 class="fw-bold text-primary mb-1 mt-1"><%= hotel.name %></h5>
                  <div class="text-danger small mb-2"><i class="fa-solid fa-location-dot me-1"></i> <%= hotel.distance_to_ghat %></div>
                  <p class="text-muted small mb-3"><%= hotel.location %></p>

                  <div class="small text-secondary mb-3">
                    <strong>Amenities:</strong> <%= hotel.amenities %>
                  </div>

                  <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                    <div>
                      <small class="text-muted">Per Night:</small>
                      <div class="fs-4 fw-bold text-success">₹<%= hotel.price_per_night.toLocaleString('en-IN') %></div>
                    </div>
                    <button class="btn btn-saffron btn-sm select-hotel-btn" 
                            data-hotel-id="<%= hotel.id %>" 
                            data-hotel-name="<%= hotel.name %>"
                            data-hotel-price="<%= hotel.price_per_night %>">
                      Reserve Room
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Hotel Booking Form Sidebar -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top bg-white" style="top: 100px;">
        <h4 class="fw-bold text-primary mb-3">
          <i class="fa-solid fa-hotel text-warning me-2"></i> Book Your Room
        </h4>
        <p class="text-muted small mb-3">Reserve your room with instant booking confirmation and zero cancellation anxiety.</p>

        <form action="/booking/hotel" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-bold">Select Hotel *</label>
            <select name="hotel_id" id="hotelSelect" class="form-select" required>
              <% hotels.forEach(h => { %>
                <option value="<%= h.id %>" data-price="<%= h.price_per_night %>">
                  <%= h.name %> (₹<%= h.price_per_night %>/night)
                </option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Check-in Date *</label>
            <input type="date" name="service_date" class="form-control" id="checkinDate" required>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label small fw-bold">Nights</label>
              <input type="number" name="nights" id="hotelNights" class="form-control" value="1" min="1" max="30" required>
            </div>
            <div class="col-6">
              <label class="form-label small fw-bold">Guests</label>
              <input type="number" name="passengers" class="form-control" value="2" min="1" max="10" required>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Full Name *</label>
            <input type="text" name="customer_name" class="form-control" placeholder="Guest Name" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Mobile (WhatsApp) *</label>
            <input type="tel" name="customer_phone" class="form-control" placeholder="10-digit number" required pattern="[0-9]{10}">
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Email *</label>
            <input type="email" name="customer_email" class="form-control" placeholder="name@example.com" required>
          </div>

          <!-- Optional Cab Combo Addon -->
          <div class="card border border-warning bg-warning-subtle rounded-3 p-3 mb-3">
            <div class="form-check form-switch mb-1">
              <input class="form-check-input" type="checkbox" id="includeCabCheck" name="include_cab" value="1" style="cursor: pointer; transform: scale(1.15);">
              <label class="form-check-label fw-bold text-dark ms-1 small" for="includeCabCheck" style="cursor: pointer;">
                🚖 Add Station / Airport Cab Pickup (Combo)
              </label>
            </div>
            <p class="text-muted small mb-0 ps-1" style="font-size: 11px;">
              Get a dedicated chauffeur to receive you at Airport / Cantt station and drop directly to your hotel.
            </p>

            <div id="comboCabFields" class="mt-2 pt-2 border-top border-warning-subtle" style="display: none;">
              <div class="mb-2">
                <label class="form-label small fw-bold">Select Vehicle *</label>
                <select name="combo_vehicle_id" id="comboVehicleSelect" class="form-select form-select-sm">
                  <% if (vehicles && vehicles.length > 0) { %>
                    <% vehicles.forEach(v => { %>
                      <option value="<%= v.id %>" data-rate="<%= v.airport_transfer_rate %>">
                        <%= v.name %> (<%= v.capacity %>-Seater) — ₹<%= v.airport_transfer_rate %>
                      </option>
                    <% }) %>
                  <% } %>
                </select>
              </div>
              <div>
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <label class="form-label small fw-bold mb-0">Pickup Point *</label>
                  <button type="button" class="btn btn-link text-danger p-0 text-decoration-none small fw-bold" id="btnHotelGps" style="font-size: 11px;">
                    <i class="fa-solid fa-location-crosshairs me-1"></i> Detect GPS
                  </button>
                </div>
                <input type="text" name="cab_pickup_point" id="hotelPickupInput" class="form-control form-control-sm" placeholder="e.g. Varanasi Cantt Station / Babatpur Airport Flight #">
                <input type="hidden" name="pickup_coords" id="hotelPickupCoords" value="">
              </div>
            </div>
          </div>

          <div class="p-3 bg-light rounded-3 mb-3">
            <div class="d-flex justify-content-between mb-1">
              <span class="text-muted small">Hotel Stay:</span>
              <span id="hotelRoomCost" class="text-dark small fw-bold">₹0</span>
            </div>
            <div id="cabCostRow" class="justify-content-between mb-1 text-warning-emphasis" style="display: none;">
              <span class="small fw-semibold"><i class="fa-solid fa-car me-1"></i> Cab Transfer:</span>
              <span id="cabTransferCost" class="small fw-bold">+₹0</span>
            </div>
            <hr class="my-1">
            <div class="d-flex justify-content-between align-items-center">
              <span class="fw-bold">Total Estimated:</span>
              <span id="hotelTotalAmount" class="fs-4 fw-bold text-success">₹3,499</span>
            </div>
          </div>

          <input type="hidden" name="total_amount" id="hotelTotalInput" value="3499">

          <button type="submit" name="payment_choice" value="PAY_ON_ARRIVAL" class="btn btn-primary-kashi w-100 py-2 mb-2">
            <i class="fa-solid fa-check me-2"></i> Confirm Room (Pay at Hotel)
          </button>
          <button type="submit" name="payment_choice" value="PAID_MOCK" class="btn btn-saffron w-100 py-2">
            <i class="fa-solid fa-credit-card me-2"></i> Pay Now (Mock Payment)
          </button>
        </form>

        <div class="mt-3 text-center">
          <small class="text-muted"><i class="fa-solid fa-shield-halved text-success me-1"></i> Best Rate Guaranteed</small>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const hotelSelect = document.getElementById('hotelSelect');
    const hotelNights = document.getElementById('hotelNights');
    const hotelRoomCost = document.getElementById('hotelRoomCost');
    const hotelTotalAmount = document.getElementById('hotelTotalAmount');
    const hotelTotalInput = document.getElementById('hotelTotalInput');
    const selectButtons = document.querySelectorAll('.select-hotel-btn');
    const checkinInput = document.getElementById('checkinDate');

    const includeCabCheck = document.getElementById('includeCabCheck');
    const comboCabFields = document.getElementById('comboCabFields');
    const comboVehicleSelect = document.getElementById('comboVehicleSelect');
    const cabCostRow = document.getElementById('cabCostRow');
    const cabTransferCost = document.getElementById('cabTransferCost');

    if (checkinInput && !checkinInput.value) {
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      checkinInput.value = tomorrow.toISOString().split('T')[0];
      checkinInput.min = new Date().toISOString().split('T')[0];
    }

    function updateHotelTotal() {
      const selectedOption = hotelSelect.options[hotelSelect.selectedIndex];
      const pricePerNight = parseFloat(selectedOption.dataset.price) || 2800;
      const nights = parseInt(hotelNights.value) || 1;
      const roomTotal = pricePerNight * nights;

      if (hotelRoomCost) {
        hotelRoomCost.innerText = `₹${roomTotal.toLocaleString('en-IN')} (${nights}N)`;
      }

      let grandTotal = roomTotal;

      if (includeCabCheck && includeCabCheck.checked && comboVehicleSelect) {
        if (comboCabFields) comboCabFields.style.display = 'block';
        const selectedVehicle = comboVehicleSelect.options[comboVehicleSelect.selectedIndex];
        const cabRate = selectedVehicle ? (parseFloat(selectedVehicle.dataset.rate) || 1100) : 1100;
        grandTotal += cabRate;

        if (cabCostRow && cabTransferCost) {
          cabCostRow.style.display = 'flex';
          cabTransferCost.innerText = `+₹${cabRate.toLocaleString('en-IN')}`;
        }
      } else {
        if (comboCabFields) comboCabFields.style.display = 'none';
        if (cabCostRow) cabCostRow.style.display = 'none';
      }

      hotelTotalAmount.innerText = `₹${grandTotal.toLocaleString('en-IN')}`;
      hotelTotalInput.value = grandTotal;
    }

    hotelSelect.addEventListener('change', updateHotelTotal);
    hotelNights.addEventListener('input', updateHotelTotal);

    if (includeCabCheck) {
      includeCabCheck.addEventListener('change', updateHotelTotal);
    }
    if (comboVehicleSelect) {
      comboVehicleSelect.addEventListener('change', updateHotelTotal);
    }

    const btnHotelGps = document.getElementById('btnHotelGps');
    const hotelPickupInput = document.getElementById('hotelPickupInput');
    const hotelPickupCoords = document.getElementById('hotelPickupCoords');
    if (btnHotelGps) {
      btnHotelGps.addEventListener('click', function () {
        if (!navigator.geolocation) {
          alert('Geolocation not supported by browser.');
          return;
        }
        btnHotelGps.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Locating...';
        navigator.geolocation.getCurrentPosition(
          function (pos) {
            const coords = `${pos.coords.latitude.toFixed(6)},${pos.coords.longitude.toFixed(6)}`;
            hotelPickupCoords.value = coords;
            hotelPickupInput.value = `Live GPS Pin (${coords})`;
            btnHotelGps.innerHTML = '<i class="fa-solid fa-check text-success me-1"></i> GPS Set';
          },
          function (err) {
            btnHotelGps.innerHTML = '<i class="fa-solid fa-location-crosshairs me-1"></i> Detect GPS';
            alert('Could not detect location. Please check browser permissions.');
          }
        );
      });
    }

    selectButtons.forEach(btn => {
      btn.addEventListener('click', function () {
        const hId = this.dataset.hotelId;
        hotelSelect.value = hId;
        updateHotelTotal();
        window.scrollTo({ top: hotelSelect.getBoundingClientRect().top + window.scrollY - 120, behavior: 'smooth' });
      });
    });

    updateHotelTotal();
  });
</script>

<%- include('partials/footer') %>
