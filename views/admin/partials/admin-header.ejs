<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Admin Console' %> | Varanasi Tour & Travel</title>
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- FontAwesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <!-- Chart.js for Visual Analytics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Admin Layout CSS (Laddoo Architecture) -->
  <link rel="stylesheet" href="/css/admin-layout.css">
</head>
<body class="admin-body">

  <!-- Sidebar -->
  <aside class="admin-sidebar" id="adminSidebar">
    <!-- Brand -->
    <a href="/admin" class="admin-sidebar-brand">
      <div class="admin-sidebar-brand-icon">
        <i class="fa-solid fa-om"></i>
      </div>
      <div class="admin-sidebar-brand-text">
        <span class="title">Kashi Admin</span>
        <span class="subtitle">Tour & Cab Control</span>
      </div>
    </a>

    <!-- Nav List -->
    <ul class="admin-nav">
      <li class="admin-nav-item">
        <a href="/admin" class="admin-nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'dashboard' ? 'active' : '' %>">
          <i class="fa-solid fa-gauge-high"></i>
          <span>Dashboard</span>
        </a>
      </li>

      <li class="admin-nav-item">
        <a href="/admin/bookings" class="admin-nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'bookings' ? 'active' : '' %>">
          <i class="fa-solid fa-calendar-check"></i>
          <span>Bookings & Rides</span>
        </a>
      </li>

      <li class="admin-nav-item">
        <a href="/admin/vehicles" class="admin-nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'vehicles' ? 'active' : '' %>">
          <i class="fa-solid fa-taxi"></i>
          <span>Cab Fleet & Tariffs</span>
        </a>
      </li>

      <li class="admin-nav-item">
        <a href="/admin/attractions" class="admin-nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'attractions' ? 'active' : '' %>">
          <i class="fa-solid fa-map-location-dot"></i>
          <span>Visiting Places (KM)</span>
        </a>
      </li>

      <li class="admin-nav-item">
        <a href="/admin/packages" class="admin-nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'packages' ? 'active' : '' %>">
          <i class="fa-solid fa-suitcase-rolling"></i>
          <span>Tour Packages</span>
        </a>
      </li>

      <li class="admin-nav-item">
        <a href="/admin/inquiries" class="admin-nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'inquiries' ? 'active' : '' %>">
          <i class="fa-solid fa-comments"></i>
          <span>Inquiries & Leads</span>
        </a>
      </li>

      <li class="admin-nav-item">
        <a href="/admin/reviews" class="admin-nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'reviews' ? 'active' : '' %>">
          <i class="fa-solid fa-star"></i>
          <span>Customer Reviews</span>
        </a>
      </li>

      <li class="admin-nav-item">
        <a href="/admin/visitors" class="admin-nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'visitors' ? 'active' : '' %>">
          <i class="fa-solid fa-earth-asia"></i>
          <span>Visitors & GeoTraffic</span>
        </a>
      </li>

      <li class="admin-nav-item">
        <a href="/admin/media" class="admin-nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'media' ? 'active' : '' %>">
          <i class="fa-solid fa-images"></i>
          <span>Photo & Media Uploads</span>
        </a>
      </li>

      <li class="admin-nav-item">
        <a href="/admin/settings" class="admin-nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'settings' ? 'active' : '' %>">
          <i class="fa-solid fa-sliders"></i>
          <span>Website Settings & SEO</span>
        </a>
      </li>

      <li class="admin-nav-item">
        <a href="/admin/profile" class="admin-nav-link <%= typeof activeTab !== 'undefined' && activeTab === 'profile' ? 'active' : '' %>">
          <i class="fa-solid fa-shield-halved"></i>
          <span>Admin Security</span>
        </a>
      </li>

      <li class="admin-nav-item mt-3 pt-2 border-top border-secondary border-opacity-25">
        <a href="/admin/logout" class="admin-nav-link text-danger">
          <i class="fa-solid fa-arrow-right-from-bracket text-danger"></i>
          <span>Sign Out</span>
        </a>
      </li>
    </ul>

    <!-- Footer of Sidebar -->
    <div class="admin-sidebar-footer">
      <span class="text-white-50 small fw-bold">Varanasi Tour Admin v2.0</span>
    </div>
  </aside>

  <!-- Main Content Column -->
  <div class="admin-main" id="adminMain">
    
    <!-- Topbar -->
    <header class="admin-topbar">
      <div class="d-flex align-items-center gap-3">
        <button class="btn btn-outline-secondary btn-sm" onclick="toggleSidebar()" title="Toggle Sidebar">
          <i class="fa-solid fa-bars"></i>
        </button>

        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-dark px-3 py-2 text-white d-flex align-items-center gap-2 rounded-pill">
            <span class="d-inline-block bg-success rounded-circle animate-pulse" style="width: 8px; height: 8px;"></span>
            <span>Admin: <strong><%= typeof currentAdmin !== 'undefined' && currentAdmin ? currentAdmin : 'SuperAdmin' %></strong></span>
          </span>
        </div>
      </div>

      <!-- Center Title -->
      <h6 class="mb-0 fw-bold d-none d-md-block text-secondary">
        <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Control Center' %>
      </h6>

      <!-- Right Actions: Clock + Live Site + Logout -->
      <div class="d-flex align-items-center gap-3">
        <div class="d-none d-lg-flex align-items-center text-muted small fw-semibold" id="adminClock">
          <i class="fa-regular fa-clock me-1 text-primary"></i> --:--:--
        </div>

        <a href="/" target="_blank" class="btn btn-sm btn-outline-primary fw-semibold">
          <i class="fa-solid fa-globe me-1"></i> Live Site
        </a>

        <a href="/admin/logout" class="btn btn-sm btn-danger">
          <i class="fa-solid fa-power-off"></i>
        </a>
      </div>
    </header>

    <!-- Page Content Container -->
    <main class="flex-grow-1 p-3 p-md-4">
