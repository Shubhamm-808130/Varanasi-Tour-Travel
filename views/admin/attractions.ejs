<%- include('partials/admin-header') %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
  <div>
    <h4 class="fw-bold text-dark mb-1"><i class="fa-solid fa-map-location-dot text-danger me-2"></i> Visiting Places & Distances Chart</h4>
    <p class="text-muted small mb-0">Control all Varanasi sightseeing spots, temples, ghats, distances in KM, travel durations, and entry fees.</p>
  </div>
  <button class="btn btn-warning fw-bold text-dark" data-bs-toggle="collapse" data-bs-target="#addAttractionCard">
    <i class="fa-solid fa-plus me-1"></i> Add New Visiting Place
  </button>
</div>

<% if (msg) { %>
  <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i> <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<!-- Add New Place Form (Collapse) -->
<div class="collapse mb-4" id="addAttractionCard">
  <div class="admin-card border border-danger shadow-sm">
    <div class="admin-card-header bg-danger bg-opacity-10">
      <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-location-dot me-2 text-danger"></i> Add New Sightseeing Destination</h6>
    </div>
    <div class="admin-card-body">
      <form action="/admin/attractions/add" method="POST" enctype="multipart/form-data">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label small fw-bold">Place Name (English) *</label>
            <input type="text" name="name" class="form-control form-control-sm" placeholder="e.g. Sarnath Dhamek Stupa" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold">Hindi Name</label>
            <input type="text" name="hindi_name" class="form-control form-control-sm" placeholder="e.g. सारनाथ धमेख स्तूप">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold">Category *</label>
            <select name="category" class="form-select form-select-sm" required>
              <option value="Temple">Temple / Mandir</option>
              <option value="Ghat">Ghat / Riverfront</option>
              <option value="Excursion">Excursion / Heritage</option>
              <option value="Cultural">Cultural / Shopping</option>
            </select>
          </div>

          <div class="col-md-3">
            <label class="form-label small fw-bold">Distance from Center (KM) *</label>
            <input type="number" step="0.1" name="distance_km" class="form-control form-control-sm" placeholder="e.g. 10.5" required>
          </div>
          <div class="col-md-3">
            <label class="form-label small fw-bold">Travel Duration *</label>
            <input type="text" name="travel_time" class="form-control form-control-sm" placeholder="e.g. 35 mins" required>
          </div>
          <div class="col-md-3">
            <label class="form-label small fw-bold">Entry Ticket Fee (₹)</label>
            <input type="number" name="entry_fee" class="form-control form-control-sm" value="0">
          </div>
          <div class="col-md-3">
            <label class="form-label small fw-bold">Location Address</label>
            <input type="text" name="location" class="form-control form-control-sm" placeholder="e.g. Sarnath, Varanasi">
          </div>

          <div class="col-md-6">
            <label class="form-label small fw-bold">Visiting Timings</label>
            <input type="text" name="timings" class="form-control form-control-sm" placeholder="e.g. 06:00 AM - 06:00 PM">
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-bold">Best Time to Visit</label>
            <input type="text" name="best_time" class="form-control form-control-sm" placeholder="e.g. Morning 8:00 AM - 11:00 AM">
          </div>

          <div class="col-md-6">
            <label class="form-label small fw-bold">Upload Place Photo (From Device)</label>
            <input type="file" name="image_file" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp">
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-bold">Or Enter Photo URL</label>
            <input type="text" name="image_url" class="form-control form-control-sm" placeholder="e.g. https://images.unsplash.com/...">
          </div>

          <div class="col-12">
            <label class="form-label small fw-bold">Brief Description & Significance</label>
            <textarea name="description" class="form-control form-control-sm" rows="2" placeholder="Brief history and spiritual importance..."></textarea>
          </div>

          <div class="col-12 text-end">
            <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-toggle="collapse" data-bs-target="#addAttractionCard">Cancel</button>
            <button type="submit" class="btn btn-danger btn-sm fw-bold">
              <i class="fa-solid fa-plus me-1"></i> Save Sightseeing Place
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Places List Table -->
<div class="admin-card">
  <div class="table-responsive">
    <table class="table admin-table align-middle">
      <thead>
        <tr>
          <th>Place & Photo</th>
          <th>Category</th>
          <th>Distance (KM)</th>
          <th>Travel Time</th>
          <th>Entry Fee</th>
          <th>Timings</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (attractions && attractions.length > 0) { %>
          <% attractions.forEach(a => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-3">
                  <img src="<%= a.image_url %>" alt="<%= a.name %>" style="width: 80px; height: 55px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0;">
                  <div>
                    <div class="fw-bold text-dark"><%= a.name %></div>
                    <small class="text-secondary"><%= a.hindi_name || '' %></small>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge bg-light text-dark border"><%= a.category %></span>
              </td>
              <td>
                <span class="badge bg-primary px-2 py-1"><i class="fa-solid fa-route me-1"></i><%= a.distance_km %> KM</span>
              </td>
              <td>
                <span class="text-dark small"><i class="fa-regular fa-clock text-secondary me-1"></i><%= a.travel_time %></span>
              </td>
              <td>
                <% if (a.entry_fee > 0) { %>
                  <span class="fw-bold text-danger">₹<%= a.entry_fee %></span>
                <% } else { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle">Free</span>
                <% } %>
              </td>
              <td>
                <small class="text-muted"><%= a.timings || 'Open daily' %></small>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <!-- Edit Button -->
                  <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editAttraction<%= a.id %>" title="Edit Place">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>

                  <!-- Delete Button -->
                  <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteAttraction<%= a.id %>" title="Delete Place">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>

                <!-- Edit Modal -->
                <div class="modal fade" id="editAttraction<%= a.id %>" tabindex="-1">
                  <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                      <form action="/admin/attractions/edit" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="<%= a.id %>">
                        <div class="modal-header">
                          <h6 class="modal-title fw-bold">Edit Place: <%= a.name %></h6>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                          <div class="row g-3">
                            <div class="col-md-6">
                              <label class="form-label small fw-bold">Place Name (English)</label>
                              <input type="text" name="name" class="form-control form-control-sm" value="<%= a.name %>" required>
                            </div>
                            <div class="col-md-6">
                              <label class="form-label small fw-bold">Hindi Name</label>
                              <input type="text" name="hindi_name" class="form-control form-control-sm" value="<%= a.hindi_name %>">
                            </div>

                            <div class="col-md-4">
                              <label class="form-label small fw-bold">Category</label>
                              <select name="category" class="form-select form-select-sm">
                                <option value="Temple" <%= a.category === 'Temple' ? 'selected' : '' %>>Temple / Mandir</option>
                                <option value="Ghat" <%= a.category === 'Ghat' ? 'selected' : '' %>>Ghat / Riverfront</option>
                                <option value="Excursion" <%= a.category === 'Excursion' ? 'selected' : '' %>>Excursion / Heritage</option>
                                <option value="Cultural" <%= a.category === 'Cultural' ? 'selected' : '' %>>Cultural / Shopping</option>
                              </select>
                            </div>
                            <div class="col-md-4">
                              <label class="form-label small fw-bold">Distance in KM</label>
                              <input type="number" step="0.1" name="distance_km" class="form-control form-control-sm" value="<%= a.distance_km %>" required>
                            </div>
                            <div class="col-md-4">
                              <label class="form-label small fw-bold">Travel Duration</label>
                              <input type="text" name="travel_time" class="form-control form-control-sm" value="<%= a.travel_time %>" required>
                            </div>

                            <div class="col-md-6">
                              <label class="form-label small fw-bold">Entry Fee (₹)</label>
                              <input type="number" name="entry_fee" class="form-control form-control-sm" value="<%= a.entry_fee || 0 %>">
                            </div>
                            <div class="col-md-6">
                              <label class="form-label small fw-bold">Timings</label>
                              <input type="text" name="timings" class="form-control form-control-sm" value="<%= a.timings %>">
                            </div>

                            <div class="col-md-6">
                              <label class="form-label small fw-bold">Best Time to Visit</label>
                              <input type="text" name="best_time" class="form-control form-control-sm" value="<%= a.best_time %>">
                            </div>
                            <div class="col-md-6">
                              <label class="form-label small fw-bold">Upload New Photo (Optional)</label>
                              <input type="file" name="image_file" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp">
                            </div>

                            <div class="col-12">
                              <label class="form-label small fw-bold">Current Photo URL</label>
                              <input type="text" name="image_url" class="form-control form-control-sm" value="<%= a.image_url %>">
                            </div>

                            <div class="col-12">
                              <label class="form-label small fw-bold">Description</label>
                              <textarea name="description" class="form-control form-control-sm" rows="3"><%= a.description %></textarea>
                            </div>
                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-warning btn-sm fw-bold">Save Changes</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>

                <!-- Delete Modal -->
                <div class="modal fade" id="deleteAttraction<%= a.id %>" tabindex="-1">
                  <div class="modal-dialog modal-sm">
                    <div class="modal-content">
                      <form action="/admin/attractions/delete" method="POST">
                        <input type="hidden" name="id" value="<%= a.id %>">
                        <div class="modal-header py-2">
                          <h6 class="modal-title fw-bold text-danger">Delete Place</h6>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body py-3 small">
                          Are you sure you want to delete <strong><%= a.name %></strong>?
                        </div>
                        <div class="modal-footer py-2">
                          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-danger btn-sm">Yes, Delete</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>

              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
