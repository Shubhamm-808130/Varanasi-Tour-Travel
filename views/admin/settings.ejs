<%- include('partials/admin-header') %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
  <div>
    <h4 class="fw-bold text-dark mb-1"><i class="fa-solid fa-sliders text-warning me-2"></i> Website Global Settings & SEO</h4>
    <p class="text-muted small mb-0">Full control to update contact numbers, WhatsApp booking link, email, physical office address, website branding, and Google Ads code.</p>
  </div>
</div>

<% if (msg) { %>
  <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i> <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="admin-card">
      <div class="admin-card-header">
        <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-pen-to-square text-primary me-2"></i> Live Website Configuration</h6>
      </div>
      <div class="admin-card-body">
        <form action="/admin/settings" method="POST">
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-bold"><i class="fa-solid fa-phone text-success me-1"></i> Primary Contact Number *</label>
              <input type="text" name="phone_primary" class="form-control form-control-sm" value="<%= settings.phone_primary || '+91 98765 43210' %>" required>
              <span class="text-muted" style="font-size: 11px;">Displayed in top header bar, Call Now buttons, and contact page.</span>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold"><i class="fa-solid fa-phone-volume text-info me-1"></i> Alternate Helpline Number</label>
              <input type="text" name="phone_secondary" class="form-control form-control-sm" value="<%= settings.phone_secondary || '+91 90123 45678' %>">
              <span class="text-muted" style="font-size: 11px;">Secondary 24x7 emergency helpline for devotees.</span>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-bold"><i class="fa-brands fa-whatsapp text-success me-1"></i> WhatsApp Booking Mobile Number *</label>
              <input type="text" name="whatsapp" class="form-control form-control-sm" value="<%= settings.whatsapp || '919876543210' %>" required>
              <span class="text-muted" style="font-size: 11px;">Directly connects customers via the floating chat pill and instant booking links.</span>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold"><i class="fa-solid fa-envelope text-warning me-1"></i> Official Email Address *</label>
              <input type="email" name="email" class="form-control form-control-sm" value="<%= settings.email || 'info@varanasitravels.com' %>" required>
              <span class="text-muted" style="font-size: 11px;">Displayed in contact cards and footer.</span>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold"><i class="fa-solid fa-location-dot text-danger me-1"></i> Physical Office Address *</label>
            <textarea name="address" class="form-control form-control-sm" rows="2" required><%= settings.address || 'D.47/158, Godowlia - Dashashwamedh Main Road, Varanasi, Uttar Pradesh - 221001' %></textarea>
            <span class="text-muted" style="font-size: 11px;">Full street address shown in footer and contact page map.</span>
          </div>

          <hr class="my-4">

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-bold"><i class="fa-solid fa-globe text-primary me-1"></i> Website Title / Brand Name *</label>
              <input type="text" name="site_title" class="form-control form-control-sm" value="<%= settings.site_title || 'Varanasi Travels' %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-bold"><i class="fa-solid fa-quote-left text-secondary me-1"></i> Brand Slogan / Tagline</label>
              <input type="text" name="site_tagline" class="form-control form-control-sm" value="<%= settings.site_tagline || 'Kashi Tour & Cab Booking' %>">
            </div>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold"><i class="fa-solid fa-rectangle-ad text-warning me-1"></i> Google AdSense / Banner Ads Code (Future Monetization)</label>
            <textarea name="ads_code" class="form-control font-monospace form-control-sm" rows="3" placeholder="Paste your Google AdSense <script> or <ins> tag code here..."><%= settings.ads_code || '' %></textarea>
            <span class="text-muted" style="font-size: 11px;">Paste your responsive Google AdSense code or sponsor banner HTML here.</span>
          </div>

          <div class="text-end">
            <button type="submit" class="btn btn-warning fw-bold px-4">
              <i class="fa-solid fa-floppy-disk me-1"></i> Save Global Settings
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="admin-card">
      <div class="admin-card-header">
        <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-shield-halved text-success me-2"></i> Instant Auto-Sync</h6>
      </div>
      <div class="admin-card-body">
        <p class="small text-muted mb-2">
          When you update any phone number, WhatsApp link, or email in this form:
        </p>
        <ul class="small text-muted ps-3 mb-3">
          <li><strong>Header Helpline Bar:</strong> Updates clickable <code>tel:</code> and <code>mailto:</code> links immediately.</li>
          <li><strong>Floating WhatsApp Pill:</strong> Customer clicks will now redirect to your new WhatsApp number.</li>
          <li><strong>Footer Details:</strong> Street address, office location, and contact cards sync automatically without editing code.</li>
          <li><strong>Ads Slot:</strong> Ad code saved here will automatically render in the designated ad slots.</li>
        </ul>
        <div class="alert alert-info py-2 small mb-0">
          <i class="fa-solid fa-info-circle me-1"></i> Database Table: <code>site_settings</code>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/admin-footer') %>
