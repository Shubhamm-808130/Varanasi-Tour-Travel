<%- include('partials/admin-header') %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
  <div>
    <h4 class="fw-bold text-dark mb-1"><i class="fa-solid fa-calendar-check text-warning me-2"></i> Bookings & Rides Manager</h4>
    <p class="text-muted small mb-0">Control all inbound cab bookings, pilgrimage tours, pickup schedules, and trip statuses.</p>
  </div>
</div>

<% if (msg) { %>
  <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i> <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<!-- Filter Pills -->
<div class="d-flex gap-2 flex-wrap mb-4">
  <a href="/admin/bookings?status=ALL" class="btn btn-sm <%= currentFilter === 'ALL' ? 'btn-dark' : 'btn-outline-secondary' %>">All Bookings</a>
  <a href="/admin/bookings?status=PENDING" class="btn btn-sm <%= currentFilter === 'PENDING' ? 'btn-warning text-dark fw-bold' : 'btn-outline-secondary' %>">Pending Confirmation</a>
  <a href="/admin/bookings?status=CONFIRMED" class="btn btn-sm <%= currentFilter === 'CONFIRMED' ? 'btn-success fw-bold' : 'btn-outline-secondary' %>">Confirmed Trips</a>
  <a href="/admin/bookings?status=COMPLETED" class="btn btn-sm <%= currentFilter === 'COMPLETED' ? 'btn-primary fw-bold' : 'btn-outline-secondary' %>">Completed</a>
  <a href="/admin/bookings?status=CANCELLED" class="btn btn-sm <%= currentFilter === 'CANCELLED' ? 'btn-danger fw-bold' : 'btn-outline-secondary' %>">Cancelled</a>
</div>

<!-- Bookings Table Card -->
<div class="admin-card">
  <div class="table-responsive">
    <table class="table admin-table align-middle">
      <thead>
        <tr>
          <th>Ref Code</th>
          <th>Customer Details</th>
          <th>Service / Vehicle</th>
          <th>Pickup Location & Date</th>
          <th>Travelers</th>
          <th>Estimated Bill</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (bookings && bookings.length > 0) { %>
          <% bookings.forEach(b => { %>
            <tr>
              <td>
                <span class="badge bg-dark font-monospace px-2 py-1"><%= b.booking_ref %></span>
                <div class="text-muted" style="font-size: 11px;"><%= b.created_at ? new Date(b.created_at).toLocaleDateString() : 'Recent' %></div>
              </td>
              <td>
                <div class="fw-bold text-dark"><%= b.customer_name %></div>
                <div class="small">
                  <a href="tel:<%= b.customer_phone %>" class="text-decoration-none text-muted">
                    <i class="fa-solid fa-phone me-1 text-primary"></i><%= b.customer_phone %>
                  </a>
                </div>
                <div class="text-muted small" style="font-size: 11px;"><%= b.customer_email %></div>
              </td>
              <td>
                <% if (b.booking_type === 'CAR_HOTEL_COMBO' || (b.vehicle_name && b.hotel_name)) { %>
                  <span class="badge bg-warning text-dark border mb-1">
                    <i class="fa-solid fa-car me-1"></i>+<i class="fa-solid fa-hotel ms-1 me-1"></i> Cab + Hotel Combo
                  </span>
                  <div class="small fw-semibold text-primary"><%= b.vehicle_name %></div>
                  <div class="small text-secondary"><i class="fa-solid fa-hotel me-1"></i><%= b.hotel_name %></div>
                <% } else if (b.booking_type === 'HOTEL' || b.hotel_name) { %>
                  <span class="badge bg-info-subtle text-dark border mb-1">
                    <i class="fa-solid fa-hotel me-1 text-primary"></i> Hotel Stay
                  </span>
                  <div class="small fw-semibold text-dark"><%= b.hotel_name || 'Hotel Room' %></div>
                <% } else { %>
                  <span class="badge bg-light text-dark border">
                    <i class="fa-solid fa-car me-1 text-warning"></i> <%= b.vehicle_name || b.package_title || b.booking_type || 'Cab Rental' %>
                  </span>
                <% } %>
                <% if (b.notes) { %>
                  <div class="text-muted small mt-1" style="font-size: 11px;">Note: <%= b.notes %></div>
                <% } %>
              </td>
              <td>
                <% 
                  const mapQ = b.pickup_coords ? b.pickup_coords : encodeURIComponent((b.pickup_location || 'Varanasi') + ', Varanasi');
                  const gMapLink = `https://www.google.com/maps/search/?api=1&query=${mapQ}`;
                %>
                <div class="fw-semibold text-dark"><i class="fa-solid fa-calendar-day text-secondary me-1"></i><%= b.service_date %></div>
                <div class="text-muted small"><i class="fa-solid fa-location-arrow text-danger me-1"></i><%= b.pickup_location || 'Varanasi City Center' %></div>
                <div class="mt-1">
                  <a href="<%= gMapLink %>" target="_blank" class="badge bg-danger-subtle text-danger border border-danger-subtle text-decoration-none" title="Open Pickup Pin on Google Maps">
                    <i class="fa-solid fa-map-location-dot me-1"></i> Open Google Map
                  </a>
                </div>
              </td>
              <td>
                <span class="badge bg-secondary rounded-pill"><%= b.passengers || 1 %> Pax</span>
              </td>
              <td>
                <span class="fw-bold text-success fs-6">₹<%= Number(b.total_amount).toLocaleString('en-IN') %></span>
              </td>
              <td>
                <% if (b.booking_status === 'CONFIRMED') { %>
                  <span class="badge-status badge-confirmed"><i class="fa-solid fa-check me-1"></i> Confirmed</span>
                <% } else if (b.booking_status === 'PENDING') { %>
                  <span class="badge-status badge-pending"><i class="fa-solid fa-clock me-1"></i> Pending</span>
                <% } else if (b.booking_status === 'COMPLETED') { %>
                  <span class="badge-status badge-completed"><i class="fa-solid fa-circle-check me-1"></i> Completed</span>
                <% } else { %>
                  <span class="badge-status badge-cancelled"><i class="fa-solid fa-xmark me-1"></i> Cancelled</span>
                <% } %>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <!-- Forward Duty with Google Maps Link to Driver on WhatsApp -->
                  <%
                    const driverMsg = encodeURIComponent(
`*🚕 NEW RIDE ALLOCATED - VARANASI TRAVELS*
Ref: ${b.booking_ref}
Customer: ${b.customer_name}
Mobile: ${b.customer_phone}
Date: ${b.service_date}
Pickup: ${b.pickup_location}
Vehicle: ${b.vehicle_name || 'Standard Cab'}
${b.hotel_name ? 'Hotel: ' + b.hotel_name : ''}
📍 *Google Maps Navigation:*
${gMapLink}

Total Fare: ₹${Number(b.total_amount).toLocaleString('en-IN')} (${b.payment_status})`
                    );
                  %>
                  <a href="https://wa.me/?text=<%= driverMsg %>" target="_blank" class="btn btn-sm btn-outline-warning text-dark" title="Forward Duty to Driver with Google Maps Pin">
                    <i class="fa-solid fa-paper-plane text-warning"></i>
                  </a>

                  <!-- WhatsApp Customer Direct -->
                  <a href="https://wa.me/<%= b.customer_phone.replace(/[^0-9]/g, '') %>?text=Hello%20<%= encodeURIComponent(b.customer_name) %>,%20this%20is%20Varanasi%20Travels%20Admin%20regarding%20your%20booking%20<%= b.booking_ref %>" target="_blank" class="btn btn-sm btn-outline-success" title="Chat on WhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                  </a>

                  <!-- Status Edit Modal Button -->
                  <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editStatus<%= b.id %>" title="Update Status">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>

                  <!-- Delete Booking Button -->
                  <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteBooking<%= b.id %>" title="Delete Booking">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>

                <!-- Update Status Modal -->
                <div class="modal fade" id="editStatus<%= b.id %>" tabindex="-1">
                  <div class="modal-dialog modal-sm">
                    <div class="modal-content">
                      <form action="/admin/bookings/status" method="POST">
                        <input type="hidden" name="booking_id" value="<%= b.id %>">
                        <div class="modal-header py-2">
                          <h6 class="modal-title fw-bold">Update Ride Status</h6>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body py-3">
                          <label class="form-label small fw-bold">Booking Ref: <%= b.booking_ref %></label>
                          <select name="status" class="form-select form-select-sm">
                            <option value="PENDING" <%= b.booking_status === 'PENDING' ? 'selected' : '' %>>PENDING</option>
                            <option value="CONFIRMED" <%= b.booking_status === 'CONFIRMED' ? 'selected' : '' %>>CONFIRMED</option>
                            <option value="COMPLETED" <%= b.booking_status === 'COMPLETED' ? 'selected' : '' %>>COMPLETED</option>
                            <option value="CANCELLED" <%= b.booking_status === 'CANCELLED' ? 'selected' : '' %>>CANCELLED</option>
                          </select>
                        </div>
                        <div class="modal-footer py-2">
                          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-warning btn-sm fw-bold">Update Status</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>

                <!-- Delete Modal -->
                <div class="modal fade" id="deleteBooking<%= b.id %>" tabindex="-1">
                  <div class="modal-dialog modal-sm">
                    <div class="modal-content">
                      <form action="/admin/bookings/delete" method="POST">
                        <input type="hidden" name="id" value="<%= b.id %>">
                        <div class="modal-header py-2">
                          <h6 class="modal-title fw-bold text-danger">Delete Booking Record</h6>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body py-3 small">
                          Are you sure you want to permanently delete booking <strong><%= b.booking_ref %></strong>?
                        </div>
                        <div class="modal-footer py-2">
                          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-danger btn-sm">Yes, Delete</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="8" class="text-center py-5 text-muted">
              <i class="fa-solid fa-calendar-xmark fa-2x mb-2 d-block text-secondary"></i>
              No bookings found in this category.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
