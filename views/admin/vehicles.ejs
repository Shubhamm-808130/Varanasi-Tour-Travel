<%- include('partials/admin-header') %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
  <div>
    <h4 class="fw-bold text-dark mb-1"><i class="fa-solid fa-taxi text-warning me-2"></i> Cab Fleet & Tariff Rates</h4>
    <p class="text-muted small mb-0">Full control over 8h/80km local package rates, extra per-km outstation tariffs, airport transfer fares, and vehicle fleet.</p>
  </div>
  <button class="btn btn-warning fw-bold text-dark" data-bs-toggle="collapse" data-bs-target="#addVehicleCard">
    <i class="fa-solid fa-plus me-1"></i> Add New Vehicle
  </button>
</div>

<% if (msg) { %>
  <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i> <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<!-- Add New Vehicle Form (Collapse) -->
<div class="collapse mb-4" id="addVehicleCard">
  <div class="admin-card border border-warning shadow-sm">
    <div class="admin-card-header bg-warning bg-opacity-10">
      <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-car-side me-2 text-warning"></i> Add New Vehicle to Fleet</h6>
    </div>
    <div class="admin-card-body">
      <form action="/admin/vehicles/add" method="POST" enctype="multipart/form-data">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label small fw-bold">Vehicle Name *</label>
            <input type="text" name="name" class="form-control form-control-sm" placeholder="e.g. Maruti Suzuki Ciaz" required>
          </div>
          <div class="col-md-3">
            <label class="form-label small fw-bold">Category *</label>
            <select name="category" class="form-select form-select-sm" required>
              <option value="Sedan">Sedan</option>
              <option value="SUV / MUV">SUV / MUV</option>
              <option value="Premium SUV">Premium SUV</option>
              <option value="Group Van">Group Van / Tempo</option>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-bold">Passengers</label>
            <input type="number" name="capacity" class="form-control form-control-sm" value="4" min="1" max="26" required>
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-bold">Luggage Bags</label>
            <input type="number" name="luggage_capacity" class="form-control form-control-sm" value="2" min="1" max="20">
          </div>
          <div class="col-md-2">
            <label class="form-label small fw-bold">Fleet Stock (Quantity) *</label>
            <input type="number" name="total_quantity" class="form-control form-control-sm" value="3" min="1" max="50" required>
          </div>

          <div class="col-md-4">
            <label class="form-label small fw-bold">Local 8h / 80km Rate (₹) *</label>
            <input type="number" name="local_base_rate" class="form-control form-control-sm" placeholder="e.g. 2200" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold">Outstation Per-KM Rate (₹) *</label>
            <input type="number" step="0.5" name="outstation_rate_per_km" class="form-control form-control-sm" placeholder="e.g. 11.5" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold">Airport Pickup / Drop Rate (₹) *</label>
            <input type="number" name="airport_transfer_rate" class="form-control form-control-sm" placeholder="e.g. 850" required>
          </div>

          <div class="col-md-6">
            <label class="form-label small fw-bold">Primary Vehicle Photo (Card Display)</label>
            <input type="file" name="image_file" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp">
            <span class="text-muted small" style="font-size: 11px;">Validated safe upload (.jpg, .png, .webp).</span>
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-bold">Or Primary Photo URL / Path</label>
            <input type="text" name="image_url" class="form-control form-control-sm" placeholder="e.g. https://images.unsplash.com/... or /images/car.jpg">
          </div>

          <!-- Multi-Image Photo Slides (Max 5 Slides) -->
          <div class="col-md-6">
            <label class="form-label small fw-bold text-primary"><i class="fa-solid fa-images me-1"></i> Multi-Image Photo Slides (Upload up to 5 photos)</label>
            <input type="file" name="gallery_files" class="form-control form-control-sm" multiple accept="image/jpeg,image/png,image/webp">
            <span class="text-muted small" style="font-size: 11px;">Select up to 5 photos from computer (exterior, interior, seating, boot).</span>
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-bold text-primary"><i class="fa-solid fa-link me-1"></i> Or Slide Image URLs (Max 5, One per line)</label>
            <textarea name="gallery_urls" rows="2" class="form-control form-control-sm" placeholder="https://... photo 1&#10;https://... photo 2"></textarea>
          </div>

          <div class="col-12">
            <label class="form-label small fw-bold">Key Features & Inclusions</label>
            <input type="text" name="features" class="form-control form-control-sm" value="Chilled AC, Uniformed Driver, Clean Seats, Bottled Water, Toll Included">
          </div>

          <div class="col-12 text-end">
            <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-toggle="collapse" data-bs-target="#addVehicleCard">Cancel</button>
            <button type="submit" class="btn btn-warning btn-sm fw-bold">
              <i class="fa-solid fa-plus me-1"></i> Add Vehicle to Fleet
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Fleet List Table -->
<div class="admin-card">
  <div class="table-responsive">
    <table class="table admin-table align-middle">
      <thead>
        <tr>
          <th>Vehicle</th>
          <th>Category</th>
          <th>Capacity</th>
          <th>Fleet Stock</th>
          <th>Local 8h/80km</th>
          <th>Outstation / km</th>
          <th>Airport Rate</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (vehicles && vehicles.length > 0) { %>
          <% vehicles.forEach(v => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-3">
                  <div class="position-relative">
                    <img src="<%= v.image_url || '/images/cars/dzire.webp' %>" alt="<%= v.name %>" style="width: 80px; height: 55px; object-fit: cover; border-radius: 8px; border: 1px solid #e2e8f0;">
                    <span class="badge bg-dark position-absolute bottom-0 end-0 m-1 px-1" style="font-size: 9px;">
                      <i class="fa-solid fa-camera"></i> <%= (v.slides && v.slides.length) || 1 %>
                    </span>
                  </div>
                  <div>
                    <div class="fw-bold text-dark"><%= v.name %></div>
                    <small class="text-muted d-block"><%= v.features %></small>
                    <div class="d-flex gap-1 mt-1">
                      <% (v.slides || []).slice(0, 5).forEach((img, i) => { %>
                        <img src="<%= img %>" alt="Slide <%= i+1 %>" style="width: 22px; height: 16px; object-fit: cover; border-radius: 2px; border: 1px solid #cbd5e1;" title="Slide <%= i+1 %>">
                      <% }); %>
                    </div>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge bg-light text-dark border"><%= v.category %></span>
              </td>
              <td>
                <span class="badge bg-secondary rounded-pill"><i class="fa-solid fa-users me-1"></i><%= v.capacity %> Pax</span>
              </td>
              <td>
                <span class="badge bg-warning text-dark fw-bold px-2 py-1">
                  <i class="fa-solid fa-car me-1"></i><%= v.total_quantity || 3 %> Cars
                </span>
              </td>
              <td>
                <span class="fw-bold text-success fs-6">₹<%= Number(v.local_base_rate).toLocaleString('en-IN') %></span>
              </td>
              <td>
                <span class="fw-bold text-dark">₹<%= v.outstation_rate_per_km %>/km</span>
              </td>
              <td>
                <span class="fw-bold text-primary">₹<%= Number(v.airport_transfer_rate).toLocaleString('en-IN') %></span>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <!-- Edit Button -->
                  <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editVehicle<%= v.id %>" title="Edit Vehicle Rates">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>

                  <!-- Delete Button -->
                  <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteVehicle<%= v.id %>" title="Delete Vehicle">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>

                <!-- Edit Vehicle Modal -->
                <div class="modal fade" id="editVehicle<%= v.id %>" tabindex="-1">
                  <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                      <form action="/admin/vehicles/edit" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="<%= v.id %>">
                        <div class="modal-header">
                          <h6 class="modal-title fw-bold">Edit Vehicle: <%= v.name %></h6>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                          <div class="row g-3">
                            <div class="col-md-6">
                              <label class="form-label small fw-bold">Vehicle Name</label>
                              <input type="text" name="name" class="form-control form-control-sm" value="<%= v.name %>" required>
                            </div>
                            <div class="col-md-6">
                              <label class="form-label small fw-bold">Category</label>
                              <select name="category" class="form-select form-select-sm">
                                <option value="Sedan" <%= v.category === 'Sedan' ? 'selected' : '' %>>Sedan</option>
                                <option value="SUV / MUV" <%= v.category === 'SUV / MUV' ? 'selected' : '' %>>SUV / MUV</option>
                                <option value="Premium SUV" <%= v.category === 'Premium SUV' ? 'selected' : '' %>>Premium SUV</option>
                                <option value="Group Van" <%= v.category === 'Group Van' ? 'selected' : '' %>>Group Van / Tempo</option>
                              </select>
                            </div>

                            <div class="col-md-4">
                              <label class="form-label small fw-bold">Seating Capacity</label>
                              <input type="number" name="capacity" class="form-control form-control-sm" value="<%= v.capacity %>" required>
                            </div>
                            <div class="col-md-3">
                              <label class="form-label small fw-bold">Luggage Bags</label>
                              <input type="number" name="luggage_capacity" class="form-control form-control-sm" value="<%= v.luggage_capacity || 2 %>">
                            </div>
                            <div class="col-md-3">
                              <label class="form-label small fw-bold">Fleet Stock (Quantity) *</label>
                              <input type="number" name="total_quantity" class="form-control form-control-sm" value="<%= v.total_quantity || 3 %>" min="1" max="50" required>
                            </div>
                            <div class="col-md-3">
                              <label class="form-label small fw-bold">Local 8h/80km Rate (₹)</label>
                              <input type="number" name="local_base_rate" class="form-control form-control-sm" value="<%= v.local_base_rate %>" required>
                            </div>

                            <div class="col-md-6">
                              <label class="form-label small fw-bold">Outstation Per-KM Rate (₹)</label>
                              <input type="number" step="0.5" name="outstation_rate_per_km" class="form-control form-control-sm" value="<%= v.outstation_rate_per_km %>" required>
                            </div>
                            <div class="col-md-6">
                              <label class="form-label small fw-bold">Airport Transfer Rate (₹)</label>
                              <input type="number" name="airport_transfer_rate" class="form-control form-control-sm" value="<%= v.airport_transfer_rate %>" required>
                            </div>

                            <div class="col-md-6">
                              <label class="form-label small fw-bold">Primary Photo File (Optional)</label>
                              <input type="file" name="image_file" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp">
                            </div>
                            <div class="col-md-6">
                              <label class="form-label small fw-bold">Primary Photo URL / Path</label>
                              <input type="text" name="image_url" class="form-control form-control-sm" value="<%= v.image_url %>">
                            </div>

                            <!-- Multi-Image Photo Slides (Max 5 Slides) -->
                            <div class="col-12 p-3 bg-light rounded border">
                              <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label small fw-bold text-primary mb-0">
                                  <i class="fa-solid fa-images me-1"></i> Vehicle Multi-Image Slides (Up to 5 Photos)
                                </label>
                                <span class="badge bg-warning text-dark"><%= (v.slides && v.slides.length) || 1 %> / 5 Slides</span>
                              </div>

                              <!-- Current Slides Preview -->
                              <% if (v.slides && v.slides.length > 0) { %>
                                <div class="d-flex flex-wrap gap-2 mb-2 p-2 bg-white rounded border">
                                  <% v.slides.forEach((sl, idx) => { %>
                                    <div class="text-center" style="width: 80px;">
                                      <img src="<%= sl %>" alt="Slide <%= idx + 1 %>" style="width: 80px; height: 50px; object-fit: cover; border-radius: 4px; border: 1px solid #e2e8f0;">
                                      <small class="text-muted d-block" style="font-size: 10px;">Slide <%= idx + 1 %></small>
                                    </div>
                                  <% }); %>
                                </div>
                              <% } %>

                              <input type="hidden" name="existing_gallery" value='<%= JSON.stringify(v.slides || []) %>'>

                              <div class="row g-2">
                                <div class="col-md-6">
                                  <label class="form-label small fw-semibold">Upload Additional / New Slide Photos</label>
                                  <input type="file" name="gallery_files" class="form-control form-control-sm" multiple accept="image/jpeg,image/png,image/webp">
                                  <small class="text-muted" style="font-size: 10px;">Select up to 5 photos (.jpg, .png, .webp)</small>
                                </div>
                                <div class="col-md-6">
                                  <label class="form-label small fw-semibold">Or Edit Slide URLs (One per line)</label>
                                  <textarea name="gallery_urls" rows="3" class="form-control form-control-sm" style="font-size: 11px;"><%= (v.slides || []).join('\n') %></textarea>
                                </div>
                              </div>
                            </div>

                            <div class="col-12">
                              <label class="form-label small fw-bold">Features & Inclusions</label>
                              <input type="text" name="features" class="form-control form-control-sm" value="<%= v.features %>">
                            </div>
                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-warning btn-sm fw-bold">Save Changes</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>

                <!-- Delete Vehicle Modal -->
                <div class="modal fade" id="deleteVehicle<%= v.id %>" tabindex="-1">
                  <div class="modal-dialog modal-sm">
                    <div class="modal-content">
                      <form action="/admin/vehicles/delete" method="POST">
                        <input type="hidden" name="id" value="<%= v.id %>">
                        <div class="modal-header py-2">
                          <h6 class="modal-title fw-bold text-danger">Delete Vehicle</h6>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body py-3 small">
                          Are you sure you want to remove <strong><%= v.name %></strong> from your cab fleet?
                        </div>
                        <div class="modal-footer py-2">
                          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-danger btn-sm">Yes, Delete</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>

              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
