<%- include('partials/admin-header') %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
  <div>
    <h4 class="fw-bold text-dark mb-1"><i class="fa-solid fa-shield-halved text-success me-2"></i> Admin Profile & Security Center</h4>
    <p class="text-muted small mb-0">Manage administrative credentials, change password with BCrypt encryption, and audit security settings.</p>
  </div>
</div>

<% if (msg) { %>
  <div class="alert alert-<%= typeof msgType !== 'undefined' ? msgType : 'info' %> alert-dismissible fade show mb-4" role="alert">
    <i class="fa-solid fa-circle-info me-2"></i> <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="row g-4">
  <!-- Profile Information & Edit -->
  <div class="col-lg-6">
    <div class="admin-card h-100">
      <div class="admin-card-header">
        <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-user-gear text-primary me-2"></i> Admin Account Details</h6>
      </div>
      <div class="admin-card-body">
        <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
          <div class="bg-primary text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 1.5rem;">
            <i class="fa-solid fa-user-shield"></i>
          </div>
          <div>
            <h5 class="fw-bold text-dark mb-0"><%= admin.username %></h5>
            <div class="badge bg-success-subtle text-success border border-success-subtle">
              <%= admin.role ? admin.role.toUpperCase() : 'SUPERADMIN' %>
            </div>
            <div class="text-muted small mt-1">
              Last Login: <%= admin.last_login ? new Date(admin.last_login).toLocaleString() : 'Active Now' %>
            </div>
          </div>
        </div>

        <form action="/admin/profile/update" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-bold">Admin Username *</label>
            <input type="text" name="username" class="form-control form-control-sm" value="<%= admin.username %>" required>
            <span class="text-muted" style="font-size: 11px;">Username used to sign into the administration console.</span>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">Admin Email Address</label>
            <input type="email" name="email" class="form-control form-control-sm" value="<%= admin.email || 'admin@varanasitravels.com' %>">
            <span class="text-muted" style="font-size: 11px;">Receives critical notifications and backup alerts.</span>
          </div>

          <div class="text-end">
            <button type="submit" class="btn btn-primary btn-sm fw-bold">
              <i class="fa-solid fa-check me-1"></i> Update Profile Info
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Change Password with BCrypt -->
  <div class="col-lg-6">
    <div class="admin-card h-100 border border-warning">
      <div class="admin-card-header bg-warning bg-opacity-10">
        <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-key text-warning me-2"></i> Change Admin Password</h6>
      </div>
      <div class="admin-card-body">
        <p class="text-muted small mb-3">
          Your password will be encrypted using standard <strong>BCrypt salted hashing</strong>. Choose a strong, secret password.
        </p>

        <form action="/admin/profile/change-password" method="POST">
          <div class="mb-3">
            <label class="form-label small fw-bold">Current Password *</label>
            <input type="password" name="current_password" class="form-control form-control-sm" placeholder="Enter current password" required>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold">New Password * (Min 6 characters)</label>
            <input type="password" name="new_password" class="form-control form-control-sm" placeholder="Enter new strong password" minlength="6" required>
          </div>

          <div class="mb-4">
            <label class="form-label small fw-bold">Confirm New Password *</label>
            <input type="password" name="confirm_password" class="form-control form-control-sm" placeholder="Re-enter new password" minlength="6" required>
          </div>

          <div class="text-end">
            <button type="submit" class="btn btn-warning btn-sm fw-bold">
              <i class="fa-solid fa-lock me-1"></i> Securely Update Password
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Security Audit Info Card -->
  <div class="col-12">
    <div class="admin-card bg-light">
      <div class="admin-card-header">
        <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-fingerprint text-success me-2"></i> Enterprise Security Controls Active</h6>
      </div>
      <div class="admin-card-body">
        <div class="row g-3">
          <div class="col-md-3">
            <div class="p-3 bg-white rounded-3 border">
              <div class="fw-bold text-success mb-1"><i class="fa-solid fa-lock me-1"></i> BCrypt Encryption</div>
              <small class="text-muted">Passwords are irreversibly salted and hashed with 10 rounds.</small>
            </div>
          </div>
          <div class="col-md-3">
            <div class="p-3 bg-white rounded-3 border">
              <div class="fw-bold text-primary mb-1"><i class="fa-solid fa-stopwatch me-1"></i> Rate Limiting</div>
              <small class="text-muted">Brute-force protection limits failed login attempts to 5 per 15 minutes.</small>
            </div>
          </div>
          <div class="col-md-3">
            <div class="p-3 bg-white rounded-3 border">
              <div class="fw-bold text-warning mb-1"><i class="fa-solid fa-cookie-bite me-1"></i> Signed HttpOnly Cookie</div>
              <small class="text-muted">Protects against XSS session theft and script tampering.</small>
            </div>
          </div>
          <div class="col-md-3">
            <div class="p-3 bg-white rounded-3 border">
              <div class="fw-bold text-danger mb-1"><i class="fa-solid fa-shield-virus me-1"></i> Upload Validator</div>
              <small class="text-muted">MIME-type validation prevents uploading PHP or malicious scripts.</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/admin-footer') %>
