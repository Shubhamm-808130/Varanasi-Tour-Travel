<%- include('partials/admin-header') %>

<!-- Top Notification Message -->
<% if (msg) { %>
  <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i> <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<!-- Metrics Stat Cards Row (Laddoo Style Gradients) -->
<div class="row g-3 g-md-4 mb-4">
  <div class="col-xl-2 col-md-4 col-6">
    <div class="card-stat blue">
      <div class="small fw-semibold text-white-50 text-uppercase">Fleet Vehicles</div>
      <h2 class="fw-bold mb-0 mt-1"><%= metrics.totalVehicles %></h2>
      <i class="fa-solid fa-taxi stat-icon"></i>
    </div>
  </div>

  <div class="col-xl-2 col-md-4 col-6">
    <div class="card-stat green">
      <div class="small fw-semibold text-white-50 text-uppercase">Total Bookings</div>
      <h2 class="fw-bold mb-0 mt-1"><%= metrics.totalBookings %></h2>
      <i class="fa-solid fa-calendar-check stat-icon"></i>
    </div>
  </div>

  <div class="col-xl-2 col-md-4 col-6">
    <div class="card-stat orange">
      <div class="small fw-semibold text-white-50 text-uppercase">Confirmed Trips</div>
      <h2 class="fw-bold mb-0 mt-1"><%= metrics.confirmedBookings %></h2>
      <i class="fa-solid fa-circle-check stat-icon"></i>
    </div>
  </div>

  <div class="col-xl-2 col-md-4 col-6">
    <div class="card-stat purple">
      <div class="small fw-semibold text-white-50 text-uppercase">Est. Revenue</div>
      <h2 class="fw-bold mb-0 mt-1">₹<%= Number(metrics.estimatedRevenue).toLocaleString('en-IN') %></h2>
      <i class="fa-solid fa-indian-rupee-sign stat-icon"></i>
    </div>
  </div>

  <div class="col-xl-2 col-md-4 col-6">
    <div class="card-stat red">
      <div class="small fw-semibold text-white-50 text-uppercase">Pending Cabs</div>
      <h2 class="fw-bold mb-0 mt-1"><%= metrics.pendingBookings %></h2>
      <i class="fa-solid fa-clock-rotate-left stat-icon"></i>
    </div>
  </div>

  <div class="col-xl-2 col-md-4 col-6">
    <div class="card-stat darkorange">
      <div class="small fw-semibold text-white-50 text-uppercase">Inquiries / Leads</div>
      <h2 class="fw-bold mb-0 mt-1"><%= metrics.totalInquiries %></h2>
      <i class="fa-solid fa-comments stat-icon"></i>
    </div>
  </div>
</div>

<!-- Live Visitor Geo Tracker Strip -->
<div class="alert alert-light border shadow-sm mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2 py-2 px-3 rounded-3 bg-white">
  <div class="d-flex align-items-center gap-2">
    <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
      <i class="fa-solid fa-satellite-dish"></i>
    </div>
    <span class="small text-dark">
      <strong>Live Geolocation Traffic:</strong> 
      <span class="text-primary fw-bold"><%= metrics.totalVisitors || 0 %></span> total visits from 
      <span class="text-success fw-bold"><%= metrics.uniqueVisitors || 0 %></span> unique IPs tracked with City, State & Device info.
    </span>
  </div>
  <a href="/admin/visitors" class="btn btn-sm btn-outline-primary fw-semibold">
    <i class="fa-solid fa-earth-asia me-1"></i> View Geo Analytics & Visitor Logs
  </a>
</div>

<!-- Charts Row: Booking Trends & Fleet Distribution -->
<div class="row g-4 mb-4">
  <div class="col-lg-8">
    <div class="admin-card h-100">
      <div class="admin-card-header">
        <h6 class="fw-bold mb-0 text-dark">
          <i class="fa-solid fa-chart-line text-primary me-2"></i> Booking & Trip Velocity Trend
        </h6>
        <span class="badge bg-light text-dark border">Real-Time Data</span>
      </div>
      <div class="admin-card-body">
        <div style="height: 270px;">
          <canvas id="bookingTrendChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="admin-card h-100">
      <div class="admin-card-header">
        <h6 class="fw-bold mb-0 text-dark">
          <i class="fa-solid fa-chart-pie text-warning me-2"></i> Fleet Categories
        </h6>
        <span class="badge bg-warning text-dark">Active Types</span>
      </div>
      <div class="admin-card-body d-flex align-items-center justify-content-center">
        <div style="width: 100%; max-width: 260px; height: 260px;">
          <canvas id="fleetCategoryChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Recent Bookings & Inquiries Row -->
<div class="row g-4">
  <!-- Recent Bookings Table -->
  <div class="col-lg-8">
    <div class="admin-card">
      <div class="admin-card-header">
        <div class="d-flex align-items-center gap-2">
          <h6 class="fw-bold mb-0 text-dark">
            <i class="fa-solid fa-list-check text-success me-2"></i> Recent Booking Requests
          </h6>
          <span class="badge bg-success-subtle text-success border border-success-subtle">Latest</span>
        </div>
        <a href="/admin/bookings" class="btn btn-sm btn-outline-primary fw-semibold">
          View All Bookings <i class="fa-solid fa-arrow-right ms-1"></i>
        </a>
      </div>
      
      <div class="table-responsive">
        <table class="table admin-table align-middle">
          <thead>
            <tr>
              <th>Ref #</th>
              <th>Customer</th>
              <th>Vehicle / Package</th>
              <th>Date</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentBookings && recentBookings.length > 0) { %>
              <% recentBookings.forEach(b => { %>
                <tr>
                  <td>
                    <span class="fw-bold text-dark font-monospace"><%= b.booking_ref %></span>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= b.customer_name %></div>
                    <div class="text-muted small">
                      <a href="tel:<%= b.customer_phone %>" class="text-decoration-none text-muted">
                        <i class="fa-solid fa-phone me-1 text-secondary"></i><%= b.customer_phone %>
                      </a>
                    </div>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border">
                      <%= b.vehicle_name || b.package_title || 'Local Sightseeing' %>
                    </span>
                  </td>
                  <td>
                    <small class="text-dark"><%= b.service_date %></small>
                  </td>
                  <td>
                    <span class="fw-bold text-success">₹<%= Number(b.total_amount).toLocaleString('en-IN') %></span>
                  </td>
                  <td>
                    <% if (b.booking_status === 'CONFIRMED') { %>
                      <span class="badge-status badge-confirmed"><i class="fa-solid fa-check me-1"></i> Confirmed</span>
                    <% } else if (b.booking_status === 'PENDING') { %>
                      <span class="badge-status badge-pending"><i class="fa-solid fa-clock me-1"></i> Pending</span>
                    <% } else if (b.booking_status === 'COMPLETED') { %>
                      <span class="badge-status badge-completed"><i class="fa-solid fa-circle-check me-1"></i> Completed</span>
                    <% } else { %>
                      <span class="badge-status badge-cancelled"><i class="fa-solid fa-xmark me-1"></i> Cancelled</span>
                    <% } %>
                  </td>
                  <td>
                    <%
                      const dashMapQ = b.pickup_coords ? b.pickup_coords : encodeURIComponent((b.pickup_location || 'Varanasi') + ', Varanasi');
                      const dashGMap = `https://www.google.com/maps/search/?api=1&query=${dashMapQ}`;
                      const dashDriverMsg = encodeURIComponent(
`*🚕 RIDE DUTY - VARANASI TRAVELS*
Ref: ${b.booking_ref}
Customer: ${b.customer_name} (${b.customer_phone})
Date: ${b.service_date}
Pickup: ${b.pickup_location || 'Varanasi'}
Vehicle: ${b.vehicle_name || 'Booked Cab'}
📍 *Maps Navigation:*
${dashGMap}
Fare: ₹${Number(b.total_amount).toLocaleString('en-IN')}`
                      );
                    %>
                    <div class="d-flex gap-1">
                      <a href="<%= dashGMap %>" target="_blank" class="btn btn-sm btn-outline-danger" title="Open Google Maps Route">
                        <i class="fa-solid fa-map-location-dot"></i>
                      </a>
                      <a href="https://wa.me/?text=<%= dashDriverMsg %>" target="_blank" class="btn btn-sm btn-outline-warning text-dark" title="Forward Duty to Driver with Map Pin">
                        <i class="fa-solid fa-paper-plane text-warning"></i>
                      </a>
                      <a href="https://wa.me/<%= b.customer_phone.replace(/[^0-9]/g, '') %>?text=Hello%20<%= encodeURIComponent(b.customer_name) %>,%20this%20is%20Varanasi%20Travels%20regarding%20your%20cab%20booking%20<%= b.booking_ref %>" target="_blank" class="btn btn-sm btn-outline-success" title="Chat on WhatsApp">
                        <i class="fa-brands fa-whatsapp"></i>
                      </a>
                      <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#statusModal<%= b.id %>" title="Change Status">
                        <i class="fa-solid fa-pen-to-square"></i>
                      </button>
                    </div>

                    <!-- Status Modal -->
                    <div class="modal fade" id="statusModal<%= b.id %>" tabindex="-1">
                      <div class="modal-dialog modal-sm">
                        <div class="modal-content">
                          <form action="/admin/bookings/status" method="POST">
                            <input type="hidden" name="booking_id" value="<%= b.id %>">
                            <div class="modal-header py-2">
                              <h6 class="modal-title fw-bold">Update Status</h6>
                              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body py-3">
                              <label class="form-label small fw-bold">Select New Status:</label>
                              <select name="status" class="form-select form-select-sm">
                                <option value="PENDING" <%= b.booking_status === 'PENDING' ? 'selected' : '' %>>PENDING</option>
                                <option value="CONFIRMED" <%= b.booking_status === 'CONFIRMED' ? 'selected' : '' %>>CONFIRMED</option>
                                <option value="COMPLETED" <%= b.booking_status === 'COMPLETED' ? 'selected' : '' %>>COMPLETED</option>
                                <option value="CANCELLED" <%= b.booking_status === 'CANCELLED' ? 'selected' : '' %>>CANCELLED</option>
                              </select>
                            </div>
                            <div class="modal-footer py-2">
                              <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                              <button type="submit" class="btn btn-warning btn-sm fw-bold">Save Status</button>
                            </div>
                          </form>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-4 text-muted">
                  <i class="fa-solid fa-calendar-xmark fa-2x mb-2 d-block text-secondary"></i>
                  No bookings recorded yet.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Recent Inquiries & Quick Shortcuts -->
  <div class="col-lg-4">
    <!-- Quick Shortcuts Card -->
    <div class="admin-card mb-4">
      <div class="admin-card-header">
        <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-bolt text-warning me-2"></i> Management Shortcuts</h6>
      </div>
      <div class="admin-card-body p-3">
        <div class="d-grid gap-2">
          <a href="/admin/vehicles" class="btn btn-outline-dark btn-sm text-start py-2">
            <i class="fa-solid fa-taxi me-2 text-warning"></i> Add New Vehicle or Update Tariffs
          </a>
          <a href="/admin/packages" class="btn btn-outline-dark btn-sm text-start py-2">
            <i class="fa-solid fa-suitcase-rolling me-2 text-primary"></i> Create Curated Tour Package
          </a>
          <a href="/admin/attractions" class="btn btn-outline-dark btn-sm text-start py-2">
            <i class="fa-solid fa-location-dot me-2 text-danger"></i> Manage Distances & Visiting Places
          </a>
          <a href="/admin/media" class="btn btn-outline-dark btn-sm text-start py-2">
            <i class="fa-solid fa-cloud-arrow-up me-2 text-info"></i> Upload Direct Vehicle Photos
          </a>
          <a href="/admin/visitors" class="btn btn-outline-dark btn-sm text-start py-2">
            <i class="fa-solid fa-earth-asia me-2 text-success"></i> Track Visitor Traffic & Geolocation
          </a>
        </div>
      </div>
    </div>

    <!-- Recent Inquiries Card -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-envelope-open-text text-info me-2"></i> Recent Inquiries</h6>
        <a href="/admin/inquiries" class="text-decoration-none small fw-bold">View All</a>
      </div>
      <div class="admin-card-body p-0">
        <div class="list-group list-group-flush">
          <% if (recentInquiries && recentInquiries.length > 0) { %>
            <% recentInquiries.forEach(inq => { %>
              <div class="list-group-item p-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                  <strong class="text-dark"><%= inq.name %></strong>
                  <span class="badge <%= inq.status === 'NEW' ? 'bg-danger' : 'bg-secondary' %> rounded-pill"><%= inq.status %></span>
                </div>
                <p class="text-muted small mb-2 text-truncate"><%= inq.message %></p>
                <div class="d-flex justify-content-between align-items-center">
                  <small class="text-secondary"><i class="fa-solid fa-phone me-1"></i><%= inq.phone %></small>
                  <a href="https://wa.me/<%= inq.phone.replace(/[^0-9]/g, '') %>?text=Hello%20<%= encodeURIComponent(inq.name) %>,%20this%20is%20Varanasi%20Travels" target="_blank" class="btn btn-sm btn-success py-0 px-2" style="font-size: 11px;">
                    <i class="fa-brands fa-whatsapp me-1"></i> Reply
                  </a>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="p-4 text-center text-muted small">No inquiries found.</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Chart.js Scripts -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 1. Line / Bar Trend Chart
    const trendCtx = document.getElementById('bookingTrendChart').getContext('2d');
    new Chart(trendCtx, {
      type: 'line',
      data: {
        labels: ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct (Current)'],
        datasets: [{
          label: 'Bookings & Trips',
          data: [12, 19, 24, 38, 45, <%= metrics.totalBookings %>],
          borderColor: '#3b82f6',
          backgroundColor: 'rgba(59, 130, 246, 0.1)',
          fill: true,
          tension: 0.35,
          borderWidth: 2,
          pointBackgroundColor: '#1d4ed8',
          pointRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: { beginAtZero: true, grid: { color: '#f1f5f9' } },
          x: { grid: { display: false } }
        }
      }
    });

    // 2. Fleet Categories Donut Chart
    const catCtx = document.getElementById('fleetCategoryChart').getContext('2d');
    const categoriesData = <%- JSON.stringify(vehicleCategories || []) %>;
    const catLabels = categoriesData.map(c => c.category);
    const catCounts = categoriesData.map(c => c.count);

    new Chart(catCtx, {
      type: 'doughnut',
      data: {
        labels: catLabels.length ? catLabels : ['Sedan', 'SUV', 'Premium', 'Van'],
        datasets: [{
          data: catCounts.length ? catCounts : [2, 1, 1, 1],
          backgroundColor: ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444'],
          borderWidth: 2,
          borderColor: '#ffffff'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' }
        },
        cutout: '65%'
      }
    });
  });
</script>

<%- include('partials/admin-footer') %>
