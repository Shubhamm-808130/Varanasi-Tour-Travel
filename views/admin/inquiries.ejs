<%- include('partials/admin-header') %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
  <div>
    <h4 class="fw-bold text-dark mb-1"><i class="fa-solid fa-comments text-info me-2"></i> Inquiries & Customer Leads</h4>
    <p class="text-muted small mb-0">Manage customer queries, tour questions, custom pilgrimage requests, and direct communications.</p>
  </div>
</div>

<% if (msg) { %>
  <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i> <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<div class="admin-card">
  <div class="table-responsive">
    <table class="table admin-table align-middle">
      <thead>
        <tr>
          <th>Customer Info</th>
          <th>Travel Date</th>
          <th>Subject & Message</th>
          <th>Status</th>
          <th>Received At</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (inquiries && inquiries.length > 0) { %>
          <% inquiries.forEach(inq => { %>
            <tr>
              <td>
                <div class="fw-bold text-dark"><%= inq.name %></div>
                <div class="small">
                  <a href="tel:<%= inq.phone %>" class="text-decoration-none text-muted">
                    <i class="fa-solid fa-phone me-1 text-primary"></i><%= inq.phone %>
                  </a>
                </div>
                <div class="text-muted small" style="font-size: 11px;"><%= inq.email %></div>
              </td>
              <td>
                <span class="badge bg-light text-dark border">
                  <i class="fa-solid fa-calendar me-1 text-secondary"></i><%= inq.travel_date || 'Flexible' %>
                </span>
              </td>
              <td style="max-width: 320px;">
                <div class="fw-semibold text-dark small"><%= inq.subject || 'Tour Inquiry' %></div>
                <div class="text-muted small text-truncate" title="<%= inq.message %>"><%= inq.message %></div>
              </td>
              <td>
                <% if (inq.status === 'NEW') { %>
                  <span class="badge bg-danger">NEW LEAD</span>
                <% } else if (inq.status === 'CONTACTED') { %>
                  <span class="badge bg-warning text-dark">CONTACTED</span>
                <% } else { %>
                  <span class="badge bg-secondary">CLOSED</span>
                <% } %>
              </td>
              <td>
                <small class="text-muted"><%= inq.created_at ? new Date(inq.created_at).toLocaleDateString() : 'Recent' %></small>
              </td>
              <td>
                <div class="d-flex gap-1">
                  <!-- WhatsApp Direct -->
                  <a href="https://wa.me/<%= inq.phone.replace(/[^0-9]/g, '') %>?text=Hello%20<%= encodeURIComponent(inq.name) %>,%20this%20is%20Varanasi%20Travels%20regarding%20your%20inquiry" target="_blank" class="btn btn-sm btn-outline-success" title="Reply on WhatsApp">
                    <i class="fa-brands fa-whatsapp"></i>
                  </a>

                  <!-- Status Modal -->
                  <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#inqStatus<%= inq.id %>" title="Update Status">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>

                  <!-- Delete -->
                  <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#inqDelete<%= inq.id %>" title="Delete Inquiry">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>

                <!-- Status Update Modal -->
                <div class="modal fade" id="inqStatus<%= inq.id %>" tabindex="-1">
                  <div class="modal-dialog modal-sm">
                    <div class="modal-content">
                      <form action="/admin/inquiries/status" method="POST">
                        <input type="hidden" name="inquiry_id" value="<%= inq.id %>">
                        <div class="modal-header py-2">
                          <h6 class="modal-title fw-bold">Update Inquiry Status</h6>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body py-3">
                          <label class="form-label small fw-bold">Customer: <%= inq.name %></label>
                          <select name="status" class="form-select form-select-sm">
                            <option value="NEW" <%= inq.status === 'NEW' ? 'selected' : '' %>>NEW</option>
                            <option value="CONTACTED" <%= inq.status === 'CONTACTED' ? 'selected' : '' %>>CONTACTED</option>
                            <option value="CLOSED" <%= inq.status === 'CLOSED' ? 'selected' : '' %>>CLOSED</option>
                          </select>
                        </div>
                        <div class="modal-footer py-2">
                          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-primary btn-sm">Update</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>

                <!-- Delete Modal -->
                <div class="modal fade" id="inqDelete<%= inq.id %>" tabindex="-1">
                  <div class="modal-dialog modal-sm">
                    <div class="modal-content">
                      <form action="/admin/inquiries/delete" method="POST">
                        <input type="hidden" name="id" value="<%= inq.id %>">
                        <div class="modal-header py-2">
                          <h6 class="modal-title fw-bold text-danger">Delete Inquiry</h6>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body py-3 small">
                          Delete inquiry from <strong><%= inq.name %></strong>?
                        </div>
                        <div class="modal-footer py-2">
                          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>

              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              No customer inquiries received yet.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/admin-footer') %>
