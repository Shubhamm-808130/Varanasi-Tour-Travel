<%- include('partials/admin-header') %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
  <div>
    <h4 class="fw-bold text-dark mb-1"><i class="fa-solid fa-suitcase-rolling text-primary me-2"></i> Tour Packages Manager</h4>
    <p class="text-muted small mb-0">Control all pilgrimage and sightseeing tour packages, itineraries, duration, pricing, and inclusions.</p>
  </div>
  <button class="btn btn-primary fw-bold" data-bs-toggle="collapse" data-bs-target="#addPackageCard">
    <i class="fa-solid fa-plus me-1"></i> Create New Tour Package
  </button>
</div>

<% if (msg) { %>
  <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
    <i class="fa-solid fa-circle-check me-2"></i> <%= msg %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<!-- Create Package Collapse Form -->
<div class="collapse mb-4" id="addPackageCard">
  <div class="admin-card border border-primary shadow-sm">
    <div class="admin-card-header bg-primary bg-opacity-10">
      <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-box-open me-2 text-primary"></i> Create Curated Tour Itinerary</h6>
    </div>
    <div class="admin-card-body">
      <form action="/admin/packages/add" method="POST" enctype="multipart/form-data">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label small fw-bold">Package Title *</label>
            <input type="text" name="title" class="form-control form-control-sm" placeholder="e.g. Complete Kashi Darshan & Boat Ride" required>
          </div>
          <div class="col-md-3">
            <label class="form-label small fw-bold">Duration *</label>
            <input type="text" name="duration" class="form-control form-control-sm" placeholder="e.g. 2 Days / 1 Night" required>
          </div>
          <div class="col-md-3">
            <label class="form-label small fw-bold">Badge / Tag</label>
            <input type="text" name="badge" class="form-control form-control-sm" placeholder="e.g. Best Seller, Trending">
          </div>

          <div class="col-md-4">
            <label class="form-label small fw-bold">Package Price (₹) *</label>
            <input type="number" name="price" class="form-control form-control-sm" placeholder="e.g. 4500" required>
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold">Original / Crossout Price (₹)</label>
            <input type="number" name="original_price" class="form-control form-control-sm" placeholder="e.g. 5500">
          </div>
          <div class="col-md-4">
            <label class="form-label small fw-bold">Subtitle</label>
            <input type="text" name="subtitle" class="form-control form-control-sm" placeholder="e.g. VIP Darshan, AC Cab & Morning Boat">
          </div>

          <div class="col-md-6">
            <label class="form-label small fw-bold">Upload Package Banner (From Device)</label>
            <input type="file" name="image_file" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp">
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-bold">Or Enter Photo URL</label>
            <input type="text" name="image_url" class="form-control form-control-sm" placeholder="e.g. https://images.unsplash.com/...">
          </div>

          <div class="col-md-6">
            <label class="form-label small fw-bold">Key Inclusions</label>
            <textarea name="inclusions" class="form-control form-control-sm" rows="3" placeholder="AC Cab for 2 days, Sunrise Boat Ride, Hotel Pickup & Drop, Fuel & Toll"></textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-bold">Exclusions</label>
            <textarea name="exclusions" class="form-control form-control-sm" rows="3" placeholder="Temple VIP Pass fees, Meals, Personal expenses"></textarea>
          </div>

          <div class="col-12">
            <label class="form-label small fw-bold">Day-by-Day Itinerary</label>
            <textarea name="itinerary" class="form-control form-control-sm" rows="3" placeholder="Day 1: Arrival, Hotel Check-in, Evening Ganga Aarti. Day 2: Morning Subah-e-Banaras, Kashi Vishwanath, Sarnath excursion."></textarea>
          </div>

          <div class="col-12 text-end">
            <button type="button" class="btn btn-secondary btn-sm me-2" data-bs-toggle="collapse" data-bs-target="#addPackageCard">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm fw-bold">
              <i class="fa-solid fa-plus me-1"></i> Publish Tour Package
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Packages List Grid -->
<div class="row g-4">
  <% if (packages && packages.length > 0) { %>
    <% packages.forEach(p => { %>
      <div class="col-lg-4 col-md-6">
        <div class="admin-card h-100">
          <div class="position-relative">
            <img src="<%= p.image_url || 'https://images.unsplash.com/photo-1561361513-2d000a50f0dc' %>" alt="<%= p.title %>" style="width: 100%; height: 180px; object-fit: cover;">
            <% if (p.badge) { %>
              <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2 fw-bold"><%= p.badge %></span>
            <% } %>
            <span class="badge bg-dark position-absolute bottom-0 end-0 m-2"><i class="fa-regular fa-clock me-1"></i><%= p.duration %></span>
          </div>

          <div class="admin-card-body p-3">
            <h6 class="fw-bold text-dark mb-1"><%= p.title %></h6>
            <p class="text-muted small mb-2"><%= p.subtitle || 'Varanasi pilgrimage tour' %></p>
            
            <div class="d-flex justify-content-between align-items-baseline mb-3">
              <div>
                <span class="fs-5 fw-bold text-success">₹<%= Number(p.price).toLocaleString('en-IN') %></span>
                <% if (p.original_price) { %>
                  <span class="text-muted text-decoration-line-through small ms-1">₹<%= Number(p.original_price).toLocaleString('en-IN') %></span>
                <% } %>
              </div>
              <span class="text-muted small">Per Person</span>
            </div>

            <div class="border-top pt-2 d-flex justify-content-between">
              <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editPackage<%= p.id %>">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit
              </button>
              <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deletePackage<%= p.id %>">
                <i class="fa-solid fa-trash me-1"></i> Delete
              </button>
            </div>
          </div>
        </div>

        <!-- Edit Package Modal -->
        <div class="modal fade" id="editPackage<%= p.id %>" tabindex="-1">
          <div class="modal-dialog modal-lg">
            <div class="modal-content">
              <form action="/admin/packages/edit" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="id" value="<%= p.id %>">
                <div class="modal-header">
                  <h6 class="modal-title fw-bold">Edit Tour Package: <%= p.title %></h6>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="form-label small fw-bold">Package Title</label>
                      <input type="text" name="title" class="form-control form-control-sm" value="<%= p.title %>" required>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label small fw-bold">Duration</label>
                      <input type="text" name="duration" class="form-control form-control-sm" value="<%= p.duration %>" required>
                    </div>
                    <div class="col-md-3">
                      <label class="form-label small fw-bold">Badge Tag</label>
                      <input type="text" name="badge" class="form-control form-control-sm" value="<%= p.badge %>">
                    </div>

                    <div class="col-md-4">
                      <label class="form-label small fw-bold">Price (₹)</label>
                      <input type="number" name="price" class="form-control form-control-sm" value="<%= p.price %>" required>
                    </div>
                    <div class="col-md-4">
                      <label class="form-label small fw-bold">Original Price (₹)</label>
                      <input type="number" name="original_price" class="form-control form-control-sm" value="<%= p.original_price %>">
                    </div>
                    <div class="col-md-4">
                      <label class="form-label small fw-bold">Subtitle</label>
                      <input type="text" name="subtitle" class="form-control form-control-sm" value="<%= p.subtitle %>">
                    </div>

                    <div class="col-md-6">
                      <label class="form-label small fw-bold">Upload New Banner (Optional)</label>
                      <input type="file" name="image_file" class="form-control form-control-sm" accept="image/jpeg,image/png,image/webp">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label small fw-bold">Current Banner URL</label>
                      <input type="text" name="image_url" class="form-control form-control-sm" value="<%= p.image_url %>">
                    </div>

                    <div class="col-md-6">
                      <label class="form-label small fw-bold">Inclusions</label>
                      <textarea name="inclusions" class="form-control form-control-sm" rows="3"><%= p.inclusions %></textarea>
                    </div>
                    <div class="col-md-6">
                      <label class="form-label small fw-bold">Exclusions</label>
                      <textarea name="exclusions" class="form-control form-control-sm" rows="3"><%= p.exclusions %></textarea>
                    </div>

                    <div class="col-12">
                      <label class="form-label small fw-bold">Itinerary</label>
                      <textarea name="itinerary" class="form-control form-control-sm" rows="3"><%= p.itinerary %></textarea>
                    </div>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-primary btn-sm fw-bold">Save Package</button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <!-- Delete Package Modal -->
        <div class="modal fade" id="deletePackage<%= p.id %>" tabindex="-1">
          <div class="modal-dialog modal-sm">
            <div class="modal-content">
              <form action="/admin/packages/delete" method="POST">
                <input type="hidden" name="id" value="<%= p.id %>">
                <div class="modal-header py-2">
                  <h6 class="modal-title fw-bold text-danger">Delete Package</h6>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3 small">
                  Are you sure you want to permanently delete <strong><%= p.title %></strong>?
                </div>
                <div class="modal-footer py-2">
                  <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-danger btn-sm">Yes, Delete</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="col-12 text-center py-5 text-muted">
      No tour packages available yet. Click "Create New Tour Package" above.
    </div>
  <% } %>
</div>

<%- include('partials/admin-footer') %>
